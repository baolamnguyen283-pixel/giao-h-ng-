 
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>🏍️ Giao Hàng 3D</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101827;color:white;font-family:Arial,sans-serif}
#game{display:block;width:100%;height:100vh}
#hud{position:fixed;inset:0;pointer-events:none}
.panel{background:#101827dd;border:1px solid #ffffff30;border-radius:14px;padding:12px;box-shadow:0 5px 20px #0003}
#top{position:absolute;top:12px;left:12px;right:12px;display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
#phone{position:absolute;left:12px;top:100px;width:210px;pointer-events:auto}
#map{position:absolute;right:12px;bottom:115px;width:155px;height:155px;border:2px solid white;border-radius:12px;background:#263b40}
#controls{position:absolute;bottom:15px;left:0;right:0;display:flex;justify-content:space-between;padding:0 20px;pointer-events:auto}
button,select,input{border:0;border-radius:10px;padding:10px;font-size:15px}
button{background:#ffbd35;color:#202020;font-weight:bold;cursor:pointer;margin:3px}
button:active{transform:scale(.96)}
#pedals button{width:62px;height:58px;background:#ffffffdd}
#start{position:fixed;inset:0;background:linear-gradient(#092b43cc,#101827ee),linear-gradient(135deg,#50c878,#2487ac);display:flex;align-items:center;justify-content:center;text-align:center;padding:20px}
#startbox{max-width:450px;width:100%;background:#132b39;border:1px solid #ffffff30;border-radius:22px;padding:24px}
#start h1{font-size:35px;margin:5px}
#start p{color:#c9dce5;line-height:1.6}
#start input,#start select{width:100%;margin:6px 0}
#notice{font-weight:bold;color:#ffe28a;line-height:1.5}
.small{font-size:12px;color:#d2e0e5}
@media(max-width:600px){#phone{width:175px;top:105px;font-size:13px}#map{width:115px;height:115px;bottom:115px}#top{font-size:13px}.panel{padding:8px}#start h1{font-size:28px}}
</style>
</head>
<body>
<canvas id="game"></canvas>
<div id="hud">
 <div id="top">
  <div class="panel">🏍️ <b>GIAO HÀNG 3D</b><br><span id="player">Tài xế</span></div>
  <div class="panel">📦 Đơn: <b id="score">0/5</b><br>💰 <b id="money">0</b>đ</div>
 </div>
 <div id="phone" class="panel">
  <b>📱 ĐIỆN THOẠI</b><hr>
  <div id="mission">Nhận nhiệm vụ để bắt đầu!</div>
  <p id="notice">Đi đến xe máy để bắt đầu.</p>
  <button onclick="toggleRide()">🏍️ Lên / xuống xe</button>
  <button onclick="newMission()">📦 Nhận đơn</button>
  <p class="small">WASD / phím mũi tên để di chuyển. Đi gần điểm giao rồi nhấn G.</p>
 </div>
 <canvas id="map" width="200" height="200"></canvas>
 <div id="controls">
  <div id="pedals">
   <div><button data-key="ArrowUp">⬆️</button></div>
   <button data-key="ArrowLeft">⬅️</button><button data-key="ArrowDown">⬇️</button><button data-key="ArrowRight">➡️</button>
  </div>
  <div><button onclick="interact()">📦 G</button><button onclick="toggleRide()">🏍️</button></div>
 </div>
</div>
<div id="start">
 <div id="startbox">
  <div style="font-size:55px">🏍️📦🏙️</div>
  <h1>GIAO HÀNG 3D</h1>
  <p>Lái xe qua thành phố, nhận đơn và giao hàng để kiếm tiền!</p>
  <input id="name" placeholder="Nhập tên tài xế của bạn" maxlength="20">
  <select id="difficulty"><option value="1">🌱 Dễ</option><option value="1.5">🔥 Khó</option></select>
  <button style="width:100%;padding:14px" onclick="startGame()">BẮT ĐẦU CHƠI ▶</button>
  <p class="small">Dùng WASD hoặc phím mũi tên để đi lại.</p>
 </div>
</div>
<script>
const canvas=document.getElementById('game'),ctx=canvas.getContext('2d');
const map=document.getElementById('map'),mc=map.getContext('2d');
let W=innerWidth,H=innerHeight,dpr=1;
function resize(){W=innerWidth;H=innerHeight;dpr=Math.min(devicePixelRatio||1,2);canvas.width=W*dpr;canvas.height=H*dpr;canvas.style.width=W+'px';canvas.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0)}
addEventListener('resize',resize);resize();
let running=false,riding=false,keys={},money=0,delivered=0,difficulty=1;
let player={x:0,z:0,a:0,speed:0};
let bike={x:0,z:0};
const places=[
 {x:0,z:0,name:'Bưu điện trung tâm',icon:'🏤'},
 {x:100,z:80,name:'Quán cà phê',icon:'☕'},
 {x:-100,z:120,name:'Siêu thị',icon:'🛒'},
 {x:150,z:-100,name:'Nhà hàng',icon:'🍜'},
 {x:-150,z:-80,name:'Cửa hàng',icon:'🏪'},
 {x:40,z:-180,name:'Khách sạn',icon:'🏨'},
 {x:-190,z:30,name:'Công viên',icon:'🌳'}
];
let order=null,phase='pickup',elapsed=0;
function startGame(){
 document.getElementById('start').style.display='none';
 document.getElementById('player').textContent=document.getElementById('name').value.trim()||'Tài xế';
 difficulty=+document.getElementById('difficulty').value;
 running=true;newMission();requestAnimationFrame(loop);
}
function newMission(){
 if(!running)return;
 if(delivered>=5){document.getElementById('notice').textContent='🏆 Bạn đã hoàn thành 5 đơn hàng!';return}
 let from=places[Math.floor(Math.random()*places.length)],to;
 do{to=places[Math.floor(Math.random()*places.length)]}while(to===from);
 order={from,to};phase='pickup';updateMission();
}
function updateMission(){
 document.getElementById('mission').innerHTML=phase==='pickup'
 ?'📦 Nhận hàng tại:<br><b>'+order.from.icon+' '+order.from.name+'</b>'
 :'🎯 Giao hàng tại:<br><b>'+order.to.icon+' '+order.to.name+'</b>';
 document.getElementById('notice').textContent=phase==='pickup'?'Đi đến điểm nhận hàng!':'Mang hàng đến khách!';
}
function toggleRide(){
 if(!running)return;
 if(!riding){
  if(Math.hypot(player.x-bike.x,player.z-bike.z)<35){riding=true;document.getElementById('notice').textContent='Đã lên xe! Đi giao hàng nào.'}
  else document.getElementById('notice').textContent='Đi bộ đến chiếc xe máy màu đỏ trước nhé!';
 }else{riding=false;player.x=bike.x;player.z=bike.z;document.getElementById('notice').textContent='Bạn đã xuống xe.'}
}
function interact(){
 if(!running||!order)return;
 let p=phase==='pickup'?order.from:order.to;
 if(Math.hypot(player.x-p.x,player.z-p.z)<35){
  if(phase==='pickup'){phase='drop';updateMission();document.getElementById('notice').textContent='Đã nhận hàng! Đi giao cho khách.'}
  else{delivered++;money+=20000;document.getElementById('score').textContent=delivered+'/5';document.getElementById('money').textContent=money.toLocaleString('vi-VN');if(delivered>=5){document.getElementById('mission').textContent='🏆 Hoàn thành tất cả đơn hàng!';document.getElementById('notice').textContent='Bạn kiếm được '+money.toLocaleString('vi-VN')+'đ!';order=null}else newMission()}
 }else document.getElementById('notice').textContent='Chưa đến nơi! Đi gần biểu tượng nhiệm vụ hơn.';
}
function blocked(x,z){
 for(let i=-3;i<=3;i++)for(let j=-3;j<=3;j++){
  let bx=i*100,bz=j*100;
  if(Math.abs(x-bx)<28&&Math.abs(z-bz)<28)return true;
 }return false;
}
function move(dt){
 let forward=(keys.ArrowUp||keys.w||keys.W?1:0)-(keys.ArrowDown||keys.s||keys.S?1:0);
 let turn=(keys.ArrowRight||keys.d||keys.D?1:0)-(keys.ArrowLeft||keys.a||keys.A?1:0);
 if(riding){
  player.a+=turn*dt*2.3;
  let speed=forward*100*difficulty;
  if(keys.ArrowDown||keys.s||keys.S)speed=-45;
  let nx=player.x+Math.sin(player.a)*speed*dt,nz=player.z+Math.cos(player.a)*speed*dt;
  if(!blocked(nx,nz)){player.x=nx;player.z=nz}
  bike.x=player.x;bike.z=player.z;
 }else{
  player.a+=turn*dt*2.8;
  let speed=forward*45;
  let nx=player.x+Math.sin(player.a)*speed*dt,nz=player.z+Math.cos(player.a)*speed*dt;
  if(!blocked(nx,nz)){player.x=nx;player.z=nz}
 }
}
function project(x,z){
 let dx=x-player.x,dz=z-player.z;
 let ca=Math.cos(player.a),sa=Math.sin(player.a);
 let forward=dx*sa+dz*ca,side=dx*ca-dz*sa;
 return {x:W/2+side*300/(forward+80),y:H*.48-forward*1.1,scale:300/(forward+80),forward};
}
function rectWorld(x,z,w,d,color){
 let pts=[[x-w/2,z-d/2],[x+w/2,z-d/2],[x+w/2,z+d/2],[x-w/2,z+d/2]].map(p=>project(p[0],p[1]));
 if(pts.some(p=>p.forward<10))return;
 ctx.fillStyle=color;ctx.beginPath();ctx.moveTo(pts[0].x,pts[0].y);pts.slice(1).forEach(p=>ctx.lineTo(p.x,p.y));ctx.closePath();ctx.fill();
}
function drawWorld(){
 let sky=ctx.createLinearGradient(0,0,0,H);sky.addColorStop(0,'#69b9f5');sky.addColorStop(.6,'#c7e7f7');sky.addColorStop(.61,'#777f80');sky.addColorStop(1,'#30383b');ctx.fillStyle=sky;ctx.fillRect(0,0,W,H);
 // city blocks and roads
 for(let x=-500;x<=500;x+=100)for(let z=-500;z<=500;z+=100){
  rectWorld(x,z,70,70,['#dfc6a1','#e7d7bc','#b9c9bc','#c8b5a1'][(Math.abs(x+z)/100)%4|0]);
  let p=project(x,z);
  if(p.forward>20&&p.forward<800&&p.scale>0){let h=90*p.scale;ctx.fillStyle=['#d5e5ed','#e6c9a9','#a8c4d4','#d2d2c5'][Math.abs(x*z/100)%4|0];ctx.fillRect(p.x-25*p.scale,p.y-h,50*p.scale,h);ctx.fillStyle='#607b8b';for(let yy=0;yy<3;yy++)for(let xx=0;xx<2;xx++)ctx.fillRect(p.x+(-15+xx*18)*p.scale,p.y-h+(15+yy*20)*p.scale,7*p.scale,9*p.scale)}
 }
 // road lines
 for(let z=20;z<800;z+=45){let p=project(player.x+Math.cos(player.a)*3,z+player.z);if(p.forward>0){ctx.fillStyle='#ffeaa0';ctx.fillRect(p.x-2*p.scale,p.y,4*p.scale,16*p.scale)}}
 // mission markers
 if(order){
  let p=phase==='pickup'?order.from:order.to,pt=project(p.x,p.z);
  if(pt.forward>5&&pt.forward<1200){ctx.font='bold '+Math.max(14,28*pt.scale)+'px Arial';ctx.textAlign='center';ctx.fillStyle='#fff';ctx.fillText(phase==='pickup'?'📦':'🎯',pt.x,pt.y-40*pt.scale);ctx.fillStyle='#fff';ctx.fillText(p.name,pt.x,pt.y-65*pt.scale)}
 }
 // motorcycle dashboard / handlebar
 if(riding){
  ctx.fillStyle='#252a31';ctx.beginPath();ctx.moveTo(W*.25,H);ctx.lineTo(W*.35,H*.79);ctx.lineTo(W*.65,H*.79);ctx.lineTo(W*.75,H);ctx.fill();
  ctx.fillStyle='#e63946';ctx.fillRect(W*.43,H*.81,W*.14,H*.08);
  ctx.strokeStyle='#202020';ctx.lineWidth=9;ctx.beginPath();ctx.moveTo(W*.5,H*.84);ctx.lineTo(W*.3,H*.76);ctx.moveTo(W*.5,H*.84);ctx.lineTo(W*.7,H*.76);ctx.stroke();
 }else{
  // player avatar
  ctx.font='42px Arial';ctx.textAlign='center';ctx.fillText('🧍',W/2,H*.76);
 }
}
function drawMap(){
 mc.clearRect(0,0,200,200);mc.fillStyle='#b9c6bb';mc.fillRect(0,0,200,200);
 mc.strokeStyle='#fff';mc.lineWidth=14;for(let i=0;i<=200;i+=40){mc.beginPath();mc.moveTo(i,0);mc.lineTo(i,200);mc.stroke();mc.beginPath();mc.moveTo(0,i);mc.lineTo(200,i);mc.stroke()}
 function dot(x,z,c,r){mc.fillStyle=c;mc.beginPath();mc.arc(100+x*.25,100+z*.25,r,0,7);mc.fill()}
 places.forEach(p=>dot(p.x,z=p.z,'#58a56b',4));
 dot(player.x,player.z,'#e63946',6);
 if(order){let p=phase==='pickup'?order.from:order.to;dot(p.x,p.z,'#ffcc35',6)}
}
let last=0;
function loop(t){
 if(!running)return;let dt=Math.min((t-last)/1000,.04)||.016;last=t;
 move(dt);drawWorld();drawMap();requestAnimationFrame(loop);
}
addEventListener('keydown',e=>{keys[e.key]=true;if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key))e.preventDefault();if(e.key.toLowerCase()==='g')interact();if(e.key.toLowerCase()==='e')toggleRide()});
addEventListener('keyup',e=>keys[e.key]=false);
document.querySelectorAll('[data-key]').forEach(b=>{
 let k=b.dataset.key;
 b.addEventListener('pointerdown',e=>{e.preventDefault();keys[k]=true});
 ['pointerup','pointerleave','pointercancel'].forEach(ev=>b.addEventListener(ev,()=>keys[k]=false));
});
</script>
</body>
</html>
